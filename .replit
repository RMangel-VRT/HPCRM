modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "schema-drift"

[[workflows.workflow]]
name = "schema-drift"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = """
pnpm --filter @workspace/scripts run check-required-extensions && pnpm --filter @workspace/scripts run check-schema-drift || (echo '
  ❌ Schema drift or missing extension detected. If schema drift: add a SQL migration in .migration-backup/migrations/ (see 0013_mailbox_backfill_runs_created_at.sql for the pattern), then run: pnpm --filter @workspace/scripts run migrate. If a required Postgres extension is missing: see replit.md \"Production schema & extensions\" for the install order (prod first, then dev, then schema).' && exit 1)"""

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 19245
externalPort = 3001

[[ports]]
localPort = 19246
externalPort = 3003

[[ports]]
localPort = 23878
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
QBO_REDIRECT_URI = "https://app.highplainsprop.com/api/qbo/callback"
QBO_ENVIRONMENT = "production"
